<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Liquid Glass UI Kit - Extended</title>
  <!-- Tweakpane for controls -->
  <script src="https://cdn.jsdelivr.net/npm/tweakpane@3.1.9/dist/tweakpane.min.js"></script>
  <!-- Phosphor Icons -->
  <script src="https://unpkg.com/@phosphor-icons/web"></script>
  <style>
      :root {
          /* --- Global Material Settings --- */
          --blur: 16px;
          --sat: 160%;
          --surface-opacity: 0.15;

          --rim-width: 1.5px;
          --rim-opacity: 0.8;
          --border-opacity: 0.3;

          --glow-size: 80px;
          --glow-opacity: 0.25;

          --shadow-opacity: 0.3;
          --shadow-base-y: 15px;
          --shadow-blur: 40px;
      }

      body {
          margin: 0;
          padding: 0;
          min-height: 100vh;
          font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
          background: #000;
          overflow-x: hidden;
          color: white;
      }

      .background-container {
          position: fixed;
          top: 0; left: 0; right: 0; bottom: 0;
          z-index: -1;
          background-image: url("https://assets.codepen.io/443195/carl-raw-8Gdayy2Lhi0-unsplash.jpg");
          background-size: 130%;
          background-position: center;
          animation: drift 60s ease-in-out infinite alternate;
      }

      .ui-grid {
          display: grid;
          grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
          gap: 50px;
          padding: 80px;
          max-width: 1400px;
          margin: 0 auto;
          perspective: 1000px;
      }

      .column {
          display: flex;
          flex-direction: column;
          gap: 30px;
      }

      h3 {
          opacity: 0.6;
          text-transform: uppercase;
          font-size: 12px;
          letter-spacing: 2px;
          margin: 0 0 5px 5px;
      }

      /* --- Liquid Glass Base --- */
      .glass {
          position: relative;
          /* JS Calculated Variables */
          --rx: 0px;
          --ry: 0px;
          --light-x: 0px;
          --light-y: 0px;
          --shadow-x: 0px;
          --shadow-y: var(--shadow-base-y);
          --cursor-deg: 135deg;

          backdrop-filter: url(#liquid-distortion) blur(var(--blur)) saturate(var(--sat));
          -webkit-backdrop-filter: url(#liquid-distortion) blur(var(--blur)) saturate(var(--sat));

          /* Surface Tint */
          background: linear-gradient(
                  var(--cursor-deg),
                  rgba(255, 255, 255, var(--surface-opacity)) 0%,
                  rgba(255, 255, 255, 0.02) 50%,
                  rgba(255, 255, 255, 0.01) 100%
          );

          /* Volumetric Shadows */
          box-shadow:
                  inset 0 0 0 1px rgba(255, 255, 255, var(--border-opacity)),
                  inset calc(var(--light-x) * 0.4) calc(var(--light-y) * 0.4) var(--glow-size) rgba(255, 255, 255, var(--glow-opacity)),
                  var(--shadow-x) var(--shadow-y) var(--shadow-blur) -5px rgba(0, 0, 0, var(--shadow-opacity));

          transition: transform 0.2s cubic-bezier(0.2, 0.8, 0.2, 1);
          will-change: transform, box-shadow, background;
          transform-style: preserve-3d;
      }

      /* Spotlight Border (Hybrid Light) */
      .glass::after {
          content: "";
          position: absolute;
          inset: 0;
          border-radius: inherit;
          padding: var(--rim-width);
          background: radial-gradient(
                  600px circle at var(--rx) var(--ry),
                  rgba(255, 255, 255, var(--rim-opacity)),
                  transparent 40%
          );
          -webkit-mask:
                  linear-gradient(#fff 0 0) content-box,
                  linear-gradient(#fff 0 0);
          -webkit-mask-composite: xor;
          mask-composite: exclude;
          pointer-events: none;
          z-index: 2;
      }

      /* --- Existing Components --- */
      .glass-card {
          border-radius: 32px;
          padding: 30px;
          min-height: 180px;
          display: flex;
          flex-direction: column;
          justify-content: space-between;
      }
      .glass-card h2 { margin: 0; font-size: 24px; font-weight: 600; }
      .glass-card p { margin: 10px 0 0; font-size: 15px; opacity: 0.7; line-height: 1.4; }
      .glass-card .meta { font-size: 12px; opacity: 0.5; margin-top: auto; text-transform: uppercase; letter-spacing: 1px; }

      .glass-btn {
          border-radius: 99px;
          height: 60px;
          display: flex;
          align-items: center;
          justify-content: center;
          gap: 10px;
          font-size: 16px;
          font-weight: 500;
          cursor: pointer;
          user-select: none;
          --surface-opacity: 0.25;
      }
      .glass-btn:hover { transform: scale(1.03) translateZ(10px); --surface-opacity: 0.3; }
      .glass-btn:active { transform: scale(0.96) translateZ(0px); }

      .icon-row { display: flex; gap: 20px; }
      .glass-icon {
          width: 80px;
          height: 80px;
          border-radius: 24px;
          display: flex;
          align-items: center;
          justify-content: center;
          font-size: 32px;
          cursor: pointer;
      }
      .glass-icon:hover { transform: translateY(-5px) scale(1.05); }

      .glass-input {
          border-radius: 16px;
          height: 50px;
          border: none;
          outline: none;
          width: 100%;
          box-sizing: border-box;
          padding: 0 20px;
          color: white;
          font-size: 16px;
          background: rgba(0, 0, 0, 0.2);
          box-shadow:
                  inset 0 2px 5px rgba(0,0,0,0.4),
                  inset 0 0 0 1px rgba(255,255,255,0.1),
                  0 1px 0 rgba(255,255,255,0.15);
          backdrop-filter: blur(10px);
      }
      .glass-input::placeholder { color: rgba(255,255,255,0.4); }
      .glass-input:focus {
          background: rgba(0, 0, 0, 0.1);
          box-shadow:
                  inset 0 2px 5px rgba(0,0,0,0.4),
                  inset 0 0 0 1px rgba(255,255,255,0.3),
                  0 1px 0 rgba(255,255,255,0.2);
      }

      /* --- NEW Chat Components --- */
      .chat-row {
          display: flex;
          gap: 12px;
          align-items: flex-end;
      }
      .chat-row.user {
          flex-direction: row-reverse;
      }

      .avatar {
          width: 40px;
          height: 40px;
          border-radius: 14px;
          display: flex;
          align-items: center;
          justify-content: center;
          font-size: 20px;
          --surface-opacity: 0.25;
          flex-shrink: 0;
      }

      .glass-bubble {
          padding: 14px 20px;
          border-radius: 20px;
          font-size: 15px;
          line-height: 1.5;
          max-width: 100%;
          /* Bubbles float closer to surface than cards */
          --shadow-base-y: 8px;
          --shadow-blur: 20px;
      }

      .glass-bubble.ai {
          border-bottom-left-radius: 4px;
      }

      .glass-bubble.user {
          border-bottom-right-radius: 4px;
          /* Distinct tint for user */
          --surface-opacity: 0.22;
      }

      /* Typing Indicator */
      .typing-pill {
          padding: 12px 18px;
          border-radius: 99px;
          display: inline-flex;
          width: auto;
          --shadow-base-y: 5px;
      }

      .typing-dots {
          display: flex;
          gap: 4px;
      }
      .dot {
          width: 6px;
          height: 6px;
          background: rgba(255,255,255,0.6);
          border-radius: 50%;
          animation: bounce 1.4s infinite ease-in-out both;
      }
      .dot:nth-child(1) { animation-delay: -0.32s; }
      .dot:nth-child(2) { animation-delay: -0.16s; }

      @keyframes bounce {
          0%, 80%, 100% { transform: scale(0); }
          40% { transform: scale(1); }
      }

      @keyframes drift {
          0% { background-position: 0% 50%; }
          50% { background-position: 100% 50%; }
          100% { background-position: 0% 50%; }
      }

      .svg-filters { position: absolute; width: 0; height: 0; }
      .tp-dfwv { min-width: 300px !important; z-index: 9999; }
  </style>
</head>
<body>

<div class="background-container"></div>

<div class="ui-grid">
  <!-- Column 1: Core Layouts -->
  <div class="column">
    <h3>Containers</h3>
    <div class="glass glass-card">
      <h2>Vision Pro</h2>
      <p>Hybrid lighting model: Volume shadows meet spotlight borders.</p>
      <div class="meta">Immersion • Depth</div>
    </div>

    <h3>Inputs</h3>
    <input type="text" class="glass-input" placeholder="Search content...">

    <div class="glass glass-card" style="min-height: 120px; justify-content: center;">
      <div style="display: flex; gap: 15px; align-items: center;">
        <i class="ph ph-music-notes" style="font-size: 30px;"></i>
        <div>
          <div style="font-weight: 600;">Liquid Sound</div>
          <div style="opacity: 0.6; font-size: 13px;">Now Playing</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Column 2: Messaging (NEW) -->
  <div class="column">
    <h3>Communication</h3>

    <!-- AI Message -->
    <div class="chat-row">
      <div class="glass avatar"><i class="ph ph-sparkle"></i></div>
      <div class="glass glass-bubble ai">
        Hello! I've updated the physics engine to support chat bubbles.
      </div>
    </div>

    <!-- User Message -->
    <div class="chat-row user">
      <div class="glass avatar"><i class="ph ph-user"></i></div>
      <div class="glass glass-bubble user">
        Looks great! The edges catch the light perfectly.
      </div>
    </div>

    <!-- Typing Indicator -->
    <div class="chat-row">
      <div class="glass avatar"><i class="ph ph-sparkle"></i></div>
      <div class="glass typing-pill">
        <div class="typing-dots">
          <div class="dot"></div>
          <div class="dot"></div>
          <div class="dot"></div>
        </div>
      </div>
    </div>

    <div class="glass glass-card" style="margin-top: auto;">
      <h2>Physics</h2>
      <p>Bubbles float slightly lower than cards to establish hierarchy.</p>
    </div>
  </div>

  <!-- Column 3: Actions -->
  <div class="column">
    <h3>Actions</h3>
    <div class="glass glass-btn">
      <i class="ph ph-paper-plane-right"></i>
      <span>Send Message</span>
    </div>
    <div class="glass glass-btn">
      <i class="ph ph-share-network"></i>
      <span>Share Content</span>
    </div>

    <h3>App Icons</h3>
    <div class="icon-row">
      <div class="glass glass-icon">
        <i class="ph ph-camera"></i>
      </div>
      <div class="glass glass-icon">
        <i class="ph ph-chat-circle-dots"></i>
      </div>
      <div class="glass glass-icon">
        <i class="ph ph-gear"></i>
      </div>
    </div>
  </div>
</div>

<svg class="svg-filters">
  <defs>
    <filter id="liquid-distortion" x="-20%" y="-20%" width="140%" height="140%" filterUnits="objectBoundingBox" primitiveUnits="userSpaceOnUse" color-interpolation-filters="sRGB">
      <feTurbulence type="turbulence" baseFrequency="0.01 0.04" numOctaves="2" seed="5" result="noise" />
      <feGaussianBlur stdDeviation="5" in="noise" result="smoothNoise" />
      <feDisplacementMap id="displacement-map" in="SourceGraphic" in2="smoothNoise" scale="30" xChannelSelector="R" yChannelSelector="G" />
    </filter>
  </defs>
</svg>

<script>
  (function() {
    const PARAMS = {
      // Physics
      sensitivity: 3.0,
      maxLightShift: 20,
      maxShadowShift: 50,

      // Material Defaults
      blur: 16,
      saturation: 160,
      surfaceOpacity: 0.15,
      refractionScale: 30,

      // Lighting Details
      rimOpacity: 0.8,
      rimWidth: 1.5,
      borderOpacity: 0.3,
      glowOpacity: 0.25,
      glowSize: 80,

      // Shadows
      shadowOpacity: 0.3,
      shadowBaseY: 15,
      shadowBlur: 40,
    };

    const root = document.documentElement;
    const displacementMap = document.getElementById('displacement-map');

    // Dynamic Caching
    let elementCache = [];
    const getGlassElements = () => document.querySelectorAll('.glass');

    function updateCache() {
      elementCache = [];
      getGlassElements().forEach(el => {
        const rect = el.getBoundingClientRect();
        elementCache.push({
          el: el,
          left: rect.left,
          top: rect.top,
          centerX: rect.left + rect.width / 2,
          centerY: rect.top + rect.height / 2
        });
      });
    }

    updateCache();
    window.addEventListener('resize', updateCache);
    window.addEventListener('load', updateCache); // Ensure fonts loaded

    const pane = new Tweakpane.Pane({ title: 'UI Kit Controls' });
    const updateGlobal = (varName, val, unit='') => root.style.setProperty(varName, val + unit);

    // 1. Material Folder
    const f1 = pane.addFolder({ title: 'Material Base' });
    f1.addInput(PARAMS, 'blur', { min: 0, max: 40 }).on('change', ev => updateGlobal('--blur', ev.value, 'px'));
    f1.addInput(PARAMS, 'saturation', { min: 0, max: 300 }).on('change', ev => updateGlobal('--sat', ev.value, '%'));
    f1.addInput(PARAMS, 'surfaceOpacity', { min: 0, max: 1 }).on('change', ev => updateGlobal('--surface-opacity', ev.value));
    f1.addInput(PARAMS, 'refractionScale', { min: 0, max: 100 }).on('change', ev => displacementMap.setAttribute('scale', ev.value));

    // 2. Lighting Folder
    const f2 = pane.addFolder({ title: 'Lighting Details' });
    f2.addInput(PARAMS, 'rimOpacity', { min: 0, max: 1 }).on('change', ev => updateGlobal('--rim-opacity', ev.value));
    f2.addInput(PARAMS, 'rimWidth', { min: 0, max: 10 }).on('change', ev => updateGlobal('--rim-width', ev.value, 'px'));
    f2.addInput(PARAMS, 'borderOpacity', { min: 0, max: 1 }).on('change', ev => updateGlobal('--border-opacity', ev.value));
    f2.addInput(PARAMS, 'glowOpacity', { min: 0, max: 1 }).on('change', ev => updateGlobal('--glow-opacity', ev.value));
    f2.addInput(PARAMS, 'glowSize', { min: 0, max: 200 }).on('change', ev => updateGlobal('--glow-size', ev.value, 'px'));

    // 3. Shadows Folder
    const f3 = pane.addFolder({ title: 'Shadows' });
    f3.addInput(PARAMS, 'shadowOpacity', { min: 0, max: 1 }).on('change', ev => updateGlobal('--shadow-opacity', ev.value));
    f3.addInput(PARAMS, 'shadowBaseY', { min: 0, max: 100 }).on('change', ev => updateGlobal('--shadow-base-y', ev.value, 'px'));
    f3.addInput(PARAMS, 'shadowBlur', { min: 0, max: 100 }).on('change', ev => updateGlobal('--shadow-blur', ev.value, 'px'));

    // 4. Physics Folder
    const f4 = pane.addFolder({ title: 'Physics' });
    f4.addInput(PARAMS, 'sensitivity', { min: 0.5, max: 10 });
    f4.addInput(PARAMS, 'maxLightShift', { min: 0, max: 100 });
    f4.addInput(PARAMS, 'maxShadowShift', { min: 0, max: 150 });


    // --- Physics Engine ---
    const clamp = (val, min, max) => Math.min(Math.max(val, min), max);

    let mouseX = window.innerWidth / 2;
    let mouseY = window.innerHeight / 2;

    document.addEventListener('mousemove', (e) => {
      mouseX = e.clientX;
      mouseY = e.clientY;
      requestAnimationFrame(renderPhysics);
    });

    function renderPhysics() {
      const normalizeX = window.innerWidth / 2;
      const normalizeY = window.innerHeight / 2;

      elementCache.forEach(item => {
        const deltaX = (mouseX - item.centerX) / normalizeX;
        const deltaY = (mouseY - item.centerY) / normalizeY;

        const angleRad = Math.atan2(deltaY, deltaX);
        const angleDeg = angleRad * (180 / Math.PI) - 90;

        let rawLightX = -deltaX * 20 * PARAMS.sensitivity;
        let rawLightY = -deltaY * 20 * PARAMS.sensitivity;
        let rawShadowX = -deltaX * 30 * PARAMS.sensitivity;
        let rawShadowY = -deltaY * 30 * PARAMS.sensitivity;

        const lightX = clamp(rawLightX, -PARAMS.maxLightShift, PARAMS.maxLightShift);
        const lightY = clamp(rawLightY, -PARAMS.maxLightShift, PARAMS.maxLightShift);
        const shadowX = clamp(rawShadowX, -PARAMS.maxShadowShift, PARAMS.maxShadowShift);
        const shadowY = clamp(rawShadowY, -PARAMS.maxShadowShift, PARAMS.maxShadowShift);

        const relativeX = mouseX - item.left;
        const relativeY = mouseY - item.top;

        item.el.style.setProperty('--rx', `${relativeX}px`);
        item.el.style.setProperty('--ry', `${relativeY}px`);

        item.el.style.setProperty('--light-x', `${lightX}px`);
        item.el.style.setProperty('--light-y', `${lightY}px`);
        item.el.style.setProperty('--shadow-x', `${shadowX}px`);
        item.el.style.setProperty('--shadow-y', `${shadowY + PARAMS.shadowBaseY}px`);
        item.el.style.setProperty('--cursor-deg', `${angleDeg}deg`);
      });
    }

    renderPhysics();
  })();
</script>
</body>
</html>